# Copy to .env and fill in. docs/operations.md lists every setting.

# Last.fm API keys, comma separated: https://www.last.fm/api/account/create
# Optional: without them every account must enter its own Last.fm key.
LASTFM_API_KEYS=
# Shared secret of the first key. Needed for "Connect Last.fm" and forwarded scrobbles.
LASTFM_API_SECRET=
# The first sign-up must enter this to become the admin. Generate with: openssl rand -hex 16
LFM_SETUP_TOKEN=

# Behind a reverse proxy with HTTPS:
# Where browsers reach the instance, used for the Last.fm callback and Secure cookies.
LFM_PUBLIC_URL=
# true when the proxy sends X-Forwarded-For and X-Forwarded-Proto.
LFM_TRUST_PROXY=false
